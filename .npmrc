# Use a flat, symlink-free node_modules layout.
#
# Next.js `output: "standalone"` bundles a node_modules tree that is then copied
# to other machines (e.g. the Windows desktop build via electron-builder). pnpm's
# default symlinked layout keeps transitive deps (like @swc/helpers, required by
# Next at runtime) only under .pnpm/ and links to them — and those symlinks break
# when the bundle is copied cross-platform, causing "Cannot find module" crashes.
# A hoisted layout places real files at the top level so the standalone bundle is
# self-contained and portable.
node-linker=hoisted
