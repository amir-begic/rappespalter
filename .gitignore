# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# database (never commit — contains personal financial data)
*.db
*.db-journal
*.db-wal
# …except the clean seed template (schema + default categories, no personal data)
!resources/template.db

# dependencies
/node_modules
/.pnp
.pnpm-store/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# electron-builder output
/dist

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Local scratch files (e.g. bank exports being analyzed)
/temp/

# Promo video: render scripts, screenshots and rendered videos (see promo/README.md)
/promo/

# Copies the app keeps next to the database (daily, before restore/update)
backups/
