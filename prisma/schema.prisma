generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Transaction {
  id           Int       @id @default(autoincrement())
  date         DateTime
  counterparty String
  amount       Float
  currency     String    @default("CHF")
  account      String
  categoryId   Int?
  category     Category? @relation(fields: [categoryId], references: [id])
  bookingText  String?
  sourceHash   String    @unique
  importedAt   DateTime  @default(now())
  importId     Int?      // the ImportBatch that added it (null: imported before batches were recorded)
  mark         TransactionMark?

  @@index([importId])
}

// One bank import (Data → Import), so it can be undone. `changes` (JSON) lists the
// rows that were already there and that this import re-filed as transfers, with
// their previous category, so undoing puts them back.
model ImportBatch {
  id         Int      @id @default(autoincrement())
  fileName   String
  format     String
  importedAt DateTime @default(now())
  count      Int      @default(0)
  changes    String?
}

// Per-transaction flags, kept out of Transaction so older databases (which the
// desktop app never migrates) keep working: the table is created on demand
// (src/lib/marks.ts). A transaction without a row has no flags.
model TransactionMark {
  transactionId  Int         @id
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  oneOff         Boolean     @default(false) // left out of trends, averages and budget comparisons
  categorySource String?     // how the category was set: rule | bank | override | fallback | manual
  reviewedAt     DateTime?   // confirmed in the review inbox (or re-mapped by hand)
}

model Snapshot {
  id        Int      @id @default(autoincrement())
  month     DateTime @unique
  etf       Float    @default(0)
  savings   Float    @default(0)
  pillar3a  Float    @default(0)
  pillar2   Float    @default(0)
  checking  Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
}

model Budget {
  id           Int      @id @default(autoincrement())
  categoryId   Int      @unique
  category     Category @relation(fields: [categoryId], references: [id])
  monthlyLimit Float
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  color        String        @default("#888888")
  type         String        @default("variable")
  transactions Transaction[]
  budget       Budget?
  rules        CategoryRule[]
}

// Auto-categorization: a transaction whose counterparty matches `pattern` gets
// `categoryId` on import (and when rules are re-applied). The longest matching
// pattern wins, so "Coop Pronto" beats "Coop".
model CategoryRule {
  id         Int      @id @default(autoincrement())
  pattern    String
  matchType  String   @default("contains") // contains | startsWith | equals
  direction  String   @default("any")      // any | in (money in) | out (money out)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

// User-editable app settings (projection inputs etc.), stored as key → value.
// Values are numeric strings; defaults come from NEXT_PUBLIC_* env vars.
model Setting {
  key   String @id
  value String
}

// ── Portfolio (standalone investment tracker, fed by broker CSV exports) ──
// Kept separate from Transaction/Snapshot: broker deposits are already counted
// on the bank side, so nothing here feeds spending, savings or net worth.

// One row per imported broker activity (trade, dividend, deposit, FX exchange…).
model PortfolioActivity {
  id              Int      @id @default(autoincrement())
  date            DateTime
  type            String   // buy | sell | dividend | deposit | withdrawal | fx | reward | other
  symbol          String?  // broker asset symbol, e.g. "VWRL"
  quantity        Float?
  price           Float?   // per unit, in `currency`
  amount          Float    // signed cash effect in `currency` (fees already included)
  currency        String
  fee             Float    @default(0) // informational — already part of `amount`
  tax             Float    @default(0) // withholding tax on dividends (amount is net)
  counterAmount   Float?   // fx: the leg received
  counterCurrency String?
  description     String
  broker          String   @default("yuh")
  sourceHash      String   @unique
  importedAt      DateTime @default(now())

  @@index([date])
}

// A held asset and how to price it. Matched to a market listing automatically
// on import; the user can override the listing or switch to manual prices.
model Security {
  symbol        String   @id // broker asset symbol
  name          String
  currency      String   // trade currency
  kind          String?  // ETF | EQUITY | … (from the price source)
  priceSource   String   @default("yahoo") // yahoo | manual
  priceSymbol   String?  // listing on the price source, e.g. "VWRL.SW"
  priceCurrency String?  // currency the listing is quoted in
  pinned        Boolean  @default(false) // user chose priceSymbol — never auto-rematch
  lastError     String?
  ter           Float?   // fund's annual fee (TER) as a fraction, 0.0022 = 0.22%
  targetWeight  Float?   // target share of the securities, 0.6 = 60%
  updatedAt     DateTime @updatedAt
}

// Daily closing prices per security, fetched or entered manually.
model SecurityPrice {
  symbol String // Security.symbol
  date   String // YYYY-MM-DD
  close  Float  // in Security.priceCurrency
  source String // yahoo | manual

  @@id([symbol, date])
}

// Daily exchange rates: 1 unit of `currency` in CHF.
model FxRate {
  currency String
  date     String // YYYY-MM-DD
  rate     Float

  @@id([currency, date])
}

// ETF look-through (docs/PORTFOLIO-LOOKTHROUGH.md): the latest constituent file
// per fund. Uploading a new file replaces the fund's previous rows.
model FundSource {
  symbol     String   @id // Security.symbol of the ETF
  provider   String   // ishares | vanguard | xtrackers
  asOf       String   // YYYY-MM-DD the file's data refers to
  fileName   String
  fundName   String?  // as printed in the file
  sourceUrl  String?  // fetched automatically on refresh (Xtrackers)
  lastError  String?  // last automatic fetch failure
  importedAt DateTime @default(now())
}

model FundConstituent {
  id         Int     @id @default(autoincrement())
  symbol     String  // FundSource.symbol
  ticker     String?
  isin       String?
  name       String
  country    String? // ISO 3166 alpha-2
  sector     String? // GICS sector
  currency   String? // trading currency, when the file says
  assetClass String  // equity | cash | other
  weight     Float   // fraction of the fund

  @@index([symbol])
}

// ── Goals (Goals page): savings goals with assets allocated to them ──
// Created on demand (src/lib/goals-store.ts), like the other tables added later.
model Goal {
  id          Int              @id @default(autoincrement())
  name        String
  kind        String           @default("other") // GOAL_KINDS in src/lib/goals.ts: picks the illustration
  target      Float            @default(0)       // CHF
  targetDate  String?          // YYYY-MM, optional
  params      String?          // JSON, kind-specific inputs (home: price, depositPct, costsPct)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  allocations GoalAllocation[]
}

// Part of an asset (a snapshot balance) set aside for a goal: a percentage of
// what's left after fixed amounts, or a fixed amount in CHF.
model GoalAllocation {
  id     Int    @id @default(autoincrement())
  goalId Int
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  asset  String // checking | savings | etf | pillar3a | pillar2
  mode   String @default("percent") // percent | amount
  value  Float  // 0–100 for percent, CHF for amount

  @@index([goalId])
}

// Something you own besides the snapshot accounts: gold, crypto, collectibles, a
// vehicle. Valued by hand (AssetValue rows) or, for vehicles, by depreciating
// from the purchase price / latest valuation. See src/lib/assets.ts.
model Asset {
  id               Int          @id @default(autoincrement())
  name             String
  kind             String       @default("other") // ASSET_KINDS in src/lib/assets.ts
  subtype          String?      // collectibles: "Pokémon cards", "Watches", …
  valuation        String       @default("manual") // manual | depreciation
  quantity         Float?       // informational: grams of gold, coins
  unit             String?
  purchaseDate     String?      // YYYY-MM-DD
  purchasePrice    Float?       // CHF
  depreciationRate Float?       // a year, declining balance: 0.15 = 15%
  residualValue    Float?       // depreciation never goes below this (CHF)
  soldDate         String?      // YYYY-MM-DD; worth nothing to you from then on
  soldPrice        Float?
  costCategories   String?      // JSON category ids whose spending is this asset's running cost
  notes            String?
  createdAt        DateTime     @default(now())
  values           AssetValue[]
  liabilities      Liability[]
}

// A valuation of an asset on a day (CHF). The latest one on or before a date wins.
model AssetValue {
  id      Int    @id @default(autoincrement())
  assetId Int
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date    String // YYYY-MM-DD
  value   Float

  @@index([assetId])
}

// A loan, mortgage or lease. Loans reduce net worth by their balance (from the
// repayment schedule, or a statement balance); a lease is a commitment — the
// remaining payments — and makes its vehicle not yours.
model Liability {
  id             Int     @id @default(autoincrement())
  name           String
  kind           String  @default("loan") // loan | lease | mortgage | other
  assetId        Int?
  asset          Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)
  principal      Float   @default(0)      // amount borrowed; for a lease the vehicle's price
  rate           Float   @default(0)      // interest a year: 0.049 = 4.9%
  startDate      String                   // YYYY-MM-DD, first payment one month later
  termMonths     Int?                     // none: open-ended (e.g. a mortgage)
  monthlyPayment Float?                   // none: annuity from principal, rate and term
  balloon        Float   @default(0)      // final payment (loan) / buyout price (lease)
  balance        Float?                   // balance from a statement…
  balanceDate    String?                  // …on this day (YYYY-MM-DD)
  counterparty   String?                  // payee of the payments in the bank export
  notes          String?
  createdAt      DateTime @default(now())

  @@index([assetId])
}
