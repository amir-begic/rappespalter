generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Transaction {
  id           Int       @id @default(autoincrement())
  date         DateTime
  counterparty String
  amount       Float
  currency     String    @default("CHF")
  account      String
  categoryId   Int?
  category     Category? @relation(fields: [categoryId], references: [id])
  bookingText  String?
  sourceHash   String    @unique
  importedAt   DateTime  @default(now())
}

model Snapshot {
  id        Int      @id @default(autoincrement())
  month     DateTime @unique
  etf       Float    @default(0)
  savings   Float    @default(0)
  pillar3a  Float    @default(0)
  pillar2   Float    @default(0)
  checking  Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
}

model Budget {
  id           Int      @id @default(autoincrement())
  categoryId   Int      @unique
  category     Category @relation(fields: [categoryId], references: [id])
  monthlyLimit Float
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  color        String        @default("#888888")
  type         String        @default("variable")
  transactions Transaction[]
  budget       Budget?
  rules        CategoryRule[]
}

// Auto-categorization: a transaction whose counterparty matches `pattern` gets
// `categoryId` on import (and when rules are re-applied). The longest matching
// pattern wins, so "Coop Pronto" beats "Coop".
model CategoryRule {
  id         Int      @id @default(autoincrement())
  pattern    String
  matchType  String   @default("contains") // contains | startsWith | equals
  direction  String   @default("any")      // any | in (money in) | out (money out)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

// User-editable app settings (projection inputs etc.), stored as key → value.
// Values are numeric strings; defaults come from NEXT_PUBLIC_* env vars.
model Setting {
  key   String @id
  value String
}

// ── Portfolio (standalone investment tracker, fed by broker CSV exports) ──
// Kept separate from Transaction/Snapshot: broker deposits are already counted
// on the bank side, so nothing here feeds spending, savings or net worth.

// One row per imported broker activity (trade, dividend, deposit, FX exchange…).
model PortfolioActivity {
  id              Int      @id @default(autoincrement())
  date            DateTime
  type            String   // buy | sell | dividend | deposit | withdrawal | fx | reward | other
  symbol          String?  // broker asset symbol, e.g. "VWRL"
  quantity        Float?
  price           Float?   // per unit, in `currency`
  amount          Float    // signed cash effect in `currency` (fees already included)
  currency        String
  fee             Float    @default(0) // informational — already part of `amount`
  tax             Float    @default(0) // withholding tax on dividends (amount is net)
  counterAmount   Float?   // fx: the leg received
  counterCurrency String?
  description     String
  broker          String   @default("yuh")
  sourceHash      String   @unique
  importedAt      DateTime @default(now())

  @@index([date])
}

// A held asset and how to price it. Matched to a market listing automatically
// on import; the user can override the listing or switch to manual prices.
model Security {
  symbol        String   @id // broker asset symbol
  name          String
  currency      String   // trade currency
  kind          String?  // ETF | EQUITY | … (from the price source)
  priceSource   String   @default("yahoo") // yahoo | manual
  priceSymbol   String?  // listing on the price source, e.g. "VWRL.SW"
  priceCurrency String?  // currency the listing is quoted in
  pinned        Boolean  @default(false) // user chose priceSymbol — never auto-rematch
  lastError     String?
  ter           Float?   // fund's annual fee (TER) as a fraction, 0.0022 = 0.22%
  targetWeight  Float?   // target share of the securities, 0.6 = 60%
  updatedAt     DateTime @updatedAt
}

// Daily closing prices per security, fetched or entered manually.
model SecurityPrice {
  symbol String // Security.symbol
  date   String // YYYY-MM-DD
  close  Float  // in Security.priceCurrency
  source String // yahoo | manual

  @@id([symbol, date])
}

// Daily exchange rates: 1 unit of `currency` in CHF.
model FxRate {
  currency String
  date     String // YYYY-MM-DD
  rate     Float

  @@id([currency, date])
}

// ETF look-through (docs/PORTFOLIO-LOOKTHROUGH.md): the latest constituent file
// per fund. Uploading a new file replaces the fund's previous rows.
model FundSource {
  symbol     String   @id // Security.symbol of the ETF
  provider   String   // ishares | vanguard | xtrackers
  asOf       String   // YYYY-MM-DD the file's data refers to
  fileName   String
  fundName   String?  // as printed in the file
  sourceUrl  String?  // fetched automatically on refresh (Xtrackers)
  lastError  String?  // last automatic fetch failure
  importedAt DateTime @default(now())
}

model FundConstituent {
  id         Int     @id @default(autoincrement())
  symbol     String  // FundSource.symbol
  ticker     String?
  isin       String?
  name       String
  country    String? // ISO 3166 alpha-2
  sector     String? // GICS sector
  currency   String? // trading currency, when the file says
  assetClass String  // equity | cash | other
  weight     Float   // fraction of the fund

  @@index([symbol])
}
