# Copy this file to `.env` and fill in your own values. `.env` is gitignored.

# SQLite database location (relative to the project root).
DATABASE_URL="file:./dev.db"

# Default projection inputs (see src/lib/settings.ts). These are only the initial
# values — they can be changed in the app on the Settings page, which takes precedence.
# All optional — omit any and the app falls back to the neutral defaults (0 / age 30).
# Monthly contributions:
NEXT_PUBLIC_MONTHLY_ETF=0
NEXT_PUBLIC_MONTHLY_3A=0
NEXT_PUBLIC_MONTHLY_PILLAR2=0
# Your current age (projection x-axis start):
NEXT_PUBLIC_START_AGE=30
# Opening balances used only when no monthly snapshot exists yet:
NEXT_PUBLIC_INIT_ETF=0
NEXT_PUBLIC_INIT_SAVINGS=0
NEXT_PUBLIC_INIT_PILLAR3A=0
NEXT_PUBLIC_INIT_PILLAR2=0
